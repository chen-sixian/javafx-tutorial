<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" spacing="10.0"
         styleClass="dialog-box"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17.0.7"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="text" maxWidth="260.0"
               styleClass="message-bubble" wrapText="true" />
        <Label fx:id="avatar" alignment="CENTER"
               maxHeight="48.0" maxWidth="48.0"
               minHeight="48.0" minWidth="48.0"
               prefHeight="48.0" prefWidth="48.0"
               styleClass="avatar" />
    </children>
</fx:root>
