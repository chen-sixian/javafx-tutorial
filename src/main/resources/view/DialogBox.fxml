<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" spacing="10.0"
         style="-fx-padding: 15 5 15 5;"
         type="HBox"
         xmlns="http://javafx.com/javafx/17.0.7"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="text" maxWidth="260.0" wrapText="true"
               style="-fx-padding: 10; -fx-background-color: #e8eef7; -fx-background-radius: 10;" />
        <Label fx:id="avatar" alignment="CENTER"
               minHeight="72.0" minWidth="72.0"
               prefHeight="72.0" prefWidth="72.0"
               style="-fx-background-color: #4169e1; -fx-background-radius: 36; -fx-text-fill: white; -fx-font-weight: bold;" />
    </children>
</fx:root>
